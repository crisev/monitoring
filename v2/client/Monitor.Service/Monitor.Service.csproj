<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- Windows service (LocalSystem): talks to the server, keeps the lease and screen-time countdowns,
       enforces School mode, sets Edge policies, starts the agent in each user session. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Monitor.Service</AssemblyName>
    <RootNamespace>Monitor.Service</RootNamespace>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Monitor.Core\Monitor.Core.csproj" />
  </ItemGroup>

</Project>
